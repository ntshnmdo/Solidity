// Constants are variables that cannot be modified. their values are hard coded and using constants can save gas cost.

// SPDX-License-Identifier: MIT
pragma solidity ^0.8.26;

contract Constants {
    // coding convention to uppercase constant variables 
    address public constant MY_ADDRESS = 0xb4115A1e2f337a8036bCf08319b6E2D7c6B5fDE4;
    uint256 public constant MY_UNIT = 123;
}